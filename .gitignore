# Build trees. Two of them, both out of source: `build/` is the host tree that runs the
# unit tests, `build-arm/` is the cross-compiled firmware image.
build/
build-arm/

# CMake's compile_commands.json is generated per build tree, and clang-tidy reads the
# copy inside build/. Nothing generated belongs in the repository.
compile_commands.json

# gtime, the commit-date walker. Its configuration is local to whoever is working in the
# tree and is no part of the deliverable, so neither filename it accepts is tracked.
# These sit at the repository root by default but the pattern has no slash, so a config
# placed elsewhere with --file is covered too. Its state is written to
# .git/gtime/state.json, which git cannot track and so needs no pattern.
#
# Both names are listed rather than just the first because gtime falls back to
# .gtime.json where tomllib is unavailable, and a file that is merely untracked is one
# `git add .` away from being committed.
.gtime.toml
.gtime.json

# Editors and tooling
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
